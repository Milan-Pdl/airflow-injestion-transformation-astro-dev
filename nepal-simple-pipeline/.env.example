# Copy this file to ".env" and fill in the blanks. Never commit the real .env

# ---- Local Postgres (where dbt built the intermediate tables) ----
PG_HOST=localhost
PG_PORT=5432
PG_DB=nepal_stock_dw
PG_USER=
PG_PASSWORD=
PG_SCHEMA_intermediate=intermediate
PG_SCHEMA_fct_historical_weekly_broker_holding_summary=fct_historical_weekly_broker_holding_summary

# ---- AWS credentials ----
# Create an IAM user (see README "AWS setup" section), generate an access
# key for it, and paste the values here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# ---- S3 / Glue / Athena names (change bucket name - must be globally unique) ----
S3_BUCKET=nepal-stock-market-lake
GLUE_DATABASE=nepal_stock_market_db
ATHENA_WORKGROUP=nepal-stock-market-wg
